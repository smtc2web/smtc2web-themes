/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "smtc2web-themes",
	"compatibility_date": "2026-09-16",
	"main": "server/index.ts",
	"assets": {
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"routes": [
		{
			"pattern": "themes.smtc2web.org",
			"custom_domain": true
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "smtc2web-themes",
			"database_id": "fbb621f2-cbb1-4349-a65a-ea342acaffe8",
			"migrations_dir": "server/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "THEMES_BUCKET",
			"bucket_name": "smtc2web-themes"
		}
	],
	"vars": {
		"GITHUB_CLIENT_ID": "Ov23lib88R2sf6GTN9Ea",
		"ADMIN_GITHUB_LOGINS": "AkarinLiu",
		"OIDC_AUDIENCE": "smtc2web-themes",
		"OIDC_WORKFLOW_REF": "smtc2web/theme-upload/.github/workflows/publish.yml"
	}
}